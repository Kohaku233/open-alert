# Copy to .env. No usable secrets are included; generate your own before starting.
NODE_ENV=development
DEPLOYMENT=node
DB_DRIVER=sqlite
SQLITE_PATH=./data/open-alert.sqlite
APP_URL=http://localhost:3000
PORT=3000
# Explicit local Vite origin. Remove for production.
DEV_ORIGIN=http://localhost:5173
AUTH_SECRET=
ENCRYPTION_KEY=
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_URL=
RESEND_API_KEY=
INVITE_ONLY=true
# Generate a separate >=32-character one-use bootstrap token.
BOOTSTRAP_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUSHOVER_APP_TOKEN=
# Only needed for PostgreSQL compose profile. Use a strong URL-safe value.
POSTGRES_PASSWORD=
# For non-compose PostgreSQL: DB_DRIVER=postgres and your own connection URL.
DATABASE_URL=
# Optional Cloudflare-only Binance perpetual relay. Store its token in Cloudflare Secrets.
# Set both bindings in the Worker deployment and MAX_GLOBAL_INSTRUMENTS<=8.
# Leave empty for the Node application. See docs/binance-vercel-relay.md.
BINANCE_RELAY_URL=
BINANCE_RELAY_TOKEN=
BINANCE_RELAY_BYPASS=

# Trade mode (Node only): the OKX relay forwards browser-signed requests over IPv4.
# Set this to the server's public IPv4 so users can whitelist it on their OKX API key.
TRADE_EGRESS_IP=
