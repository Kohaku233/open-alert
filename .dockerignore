# Install inside the build stage; never copy host native modules or artifacts
**/node_modules
**/dist
**/.wrangler
**/.npm
**/.npm-cache*
**/.cache
**/.vite
**/*.tsbuildinfo
**/.git
**/.claude
**/.vscode
**/.idea

# No runtime secrets, identities or private package registry config in context
**/.env
**/.env.*
!.env.example
**/.dev.vars
**/.dev.vars.*
**/.npmrc
**/secrets
**/secrets.*
**/credentials
**/credentials.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.age
**/*.enc

# No persisted databases or private backup/import state
**/data
**/private
**/backups
**/backup
**/*.sqlite*
**/*.db
**/*.db-*
**/*.dump
**/*.backup
**/*.bak
**/*.sql.gz
**/*-backup.sql
**/backup-*.sql
**/legacy-state*.json
**/*channel-secrets*.json
**/new-channel*.json
**/*.artifact.json

# No development reports, internal handoffs or packed source archives
/test
**/test-output
**/test-results
**/playwright-report
**/coverage
**/*.log
**/*_HANDOFF*
**/*REQUIREMENTS*
/docs/internal
**/*.zip
**/*.tar
**/*.tar.gz
**/.DS_Store
**/Thumbs.db
