---
const { siteTitleHref } = Astro.locals.starlightRoute;
---
<a href={siteTitleHref} class="oa-brand" aria-label="价格哨站文档首页">
  <svg viewBox="0 0 48 48" aria-hidden="true" class="oa-mark">
    <path d="M8 22A16 16 0 0 1 40 22Z" fill="var(--oa-mark-top)" transform="translate(3 -1.5)"/>
    <path d="M8 26A16 16 0 0 0 40 26Z" fill="var(--oa-mark-bottom)" transform="translate(-3 1.5)"/>
  </svg>
  <span class="oa-name">价格哨站<small>openalert</small></span>
  <span class="oa-tag">docs</span>
</a>
<style>
  .oa-brand { display: flex; align-items: center; gap: 11px; color: var(--sl-color-white); text-decoration: none; white-space: nowrap; min-width: 0; }
  .oa-mark { width: 32px; height: 32px; flex: none; }
  .oa-name { display: flex; flex-direction: column; line-height: 1.1; font-size: 16px; font-weight: 500; }
  .oa-name small { font-size: 10px; font-weight: 500; letter-spacing: -0.02em; color: var(--sl-color-gray-3); margin-top: 4px; }
  .oa-tag { font-family: var(--sl-font-mono); font-size: 11px; color: var(--sl-color-gray-3); border: 1px solid var(--sl-color-hairline-light); border-radius: 999px; padding: 2px 9px; }
  @media (max-width: 30rem) { .oa-tag { display: none; } }
</style>
