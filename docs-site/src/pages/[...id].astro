---
import { execFileSync } from 'node:child_process';
import { getCollection, render } from 'astro:content';
import Docs from '../layouts/Docs.astro';
import { nav, href } from '../nav';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const all = await getCollection('docs');
const titleOf = (id: string) => all.find((e) => e.id === id)?.data.title ?? id;
const order = nav.flatMap((g) => g.items);
const at = order.indexOf(entry.id);
const prevId = at > 0 ? order[at - 1] : undefined;
const nextId = at >= 0 && at < order.length - 1 ? order[at + 1] : undefined;
const group = nav.find((g) => g.items.includes(entry.id))?.label;

// Last change date of the source file, from git. Falls back to nothing outside a git checkout.
let updated = '';
try {
  updated = execFileSync('git', ['log', '-1', '--format=%cs', '--', `src/content/docs/${entry.filePath?.split('src/content/docs/')[1] ?? ''}`], { encoding: 'utf8' }).trim();
} catch {}
const chars = (entry.body ?? '').replace(/[\s#*`|>\-_[\]()]/g, '').length;
const minutes = Math.max(1, Math.round(chars / 450));
const meta = [
  ...(group ? [{ label: '分类', value: group }] : []),
  { label: '阅读约', value: `${minutes} 分钟` },
  ...(updated ? [{ label: '更新于', value: updated }] : []),
];
---
<Docs
  title={entry.data.title}
  description={entry.data.description}
  current={entry.id}
  group={group}
  meta={meta}
  headings={headings}
  pager={{
    prev: prevId ? { href: href(prevId), title: titleOf(prevId) } : undefined,
    next: nextId ? { href: href(nextId), title: titleOf(nextId) } : undefined,
  }}
>
  <Content />
</Docs>
