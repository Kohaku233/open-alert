---
import { execFileSync } from 'node:child_process';
import { getCollection, render } from 'astro:content';
import Docs from '../layouts/Docs.astro';
import { nav } from '../nav';
import { pageHref, ui, type Lang } from '../i18n';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const lang: Lang = entry.id.startsWith('en/') ? 'en' : 'zh';
const t = ui(lang);
// Page id without the language folder, as listed in nav.ts.
const id = lang === 'en' ? entry.id.slice(3) : entry.id;
const { Content, headings } = await render(entry);
const all = await getCollection('docs');
const titleOf = (pageId: string) => all.find((e) => e.id === (lang === 'en' ? `en/${pageId}` : pageId))?.data.title ?? pageId;
const order = nav.flatMap((g) => g.items);
const at = order.indexOf(id);
const prevId = at > 0 ? order[at - 1] : undefined;
const nextId = at >= 0 && at < order.length - 1 ? order[at + 1] : undefined;
const group = nav.find((g) => g.items.includes(id))?.label[lang];

// Last change date of the source file, from git. Falls back to nothing outside a git checkout.
let updated = '';
try {
  updated = execFileSync('git', ['log', '-1', '--format=%cs', '--', `src/content/docs/${entry.filePath?.split('src/content/docs/')[1] ?? ''}`], { encoding: 'utf8' }).trim();
} catch {}
const body = entry.body ?? '';
// Chinese reads at about 450 characters a minute, English at about 220 words.
const minutes = Math.max(1, Math.round(lang === 'en'
  ? body.split(/\s+/).filter((w) => /[A-Za-z0-9]/.test(w)).length / 220
  : body.replace(/[\s#*`|>\-_[\]()]/g, '').length / 450));
const meta = [
  ...(group ? [{ label: t.group, value: group }] : []),
  { label: t.reading, value: t.minutes(minutes) },
  ...(updated ? [{ label: t.updated, value: updated }] : []),
];
---
<Docs
  title={entry.data.title}
  description={entry.data.description}
  current={id}
  group={group}
  meta={meta}
  headings={headings}
  pager={{
    prev: prevId ? { href: pageHref(lang, prevId), title: titleOf(prevId) } : undefined,
    next: nextId ? { href: pageHref(lang, nextId), title: titleOf(nextId) } : undefined,
  }}
>
  <Content />
</Docs>
