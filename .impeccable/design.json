  "narrative": {
    "northStar": "The Black-White Workbench",
    "overview": "A familiar, compact developer workbench puts precise prices and rule actions ahead of decoration. The user selected the black-white direction and Vercel as its sole visual reference. Near-black canvas, flat charcoal panels, quiet separators and white primary actions define the implemented system.\n\nThe original threshold-pulse SVG supplies identity. Restrained lime communicates activity and focus; amber communicates locked states, uncertainty and warnings. Chinese uses the system sans-serif stack, English uses self-hosted Sora, and tabular monospace keeps numeric values stable.",
    "keyCharacteristics": [
      "Compact dark surfaces with clear separators.",
      "White primary actions with restrained semantic accents.",
      "Self-hosted English type, readable Chinese copy and tabular prices.",
      "Equal Chinese and English functionality and mobile actions."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Pair monitoring and delivery colors with readable status labels.",
        "section": "colors"
      },
      {
        "name": "The Native Chart Rule",
        "body": "Preserve TradingView controls and attribution when adapting the surrounding workbench.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use neutral surfaces and white primary actions.",
      "Do pair state colors with explicit Chinese and English labels.",
      "Do preserve prominent tabular prices and readable supporting copy.",
      "Do retain visible keyboard focus and the implemented mobile touch targets.",
      "Do retain the original SVG identity and native chart affordances."
    ],
    "donts": [
      "Don't reintroduce the discarded plum or circuit palettes.",
      "Don't use color as the only explanation of monitoring or delivery state.",
      "Don't load raster replacements for the shipped SVG identity.",
      "Don't apply the app font or custom controls inside the external TradingView iframe."
    ]
  }
}
