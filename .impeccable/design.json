      "html": "<button class=\"ds-switch\" type=\"button\" role=\"switch\" aria-checked=\"true\" aria-label=\"Monitoring enabled\"></button>",
      "css": ".ds-switch{width:44px;height:28px;min-height:28px;border-radius:14px;background:#555;border:0;padding:2px;position:relative;cursor:pointer;transition:background .16s,border-color .16s}.ds-switch:hover{background:#292929}.ds-switch:after{content:\"\";position:absolute;width:18px;height:18px;border-radius:50%;top:5px;left:5px;background:var(--bg,#111111)}.ds-switch[aria-checked=true]{background:var(--accent,#b6f36a)}.ds-switch[aria-checked=true]:after{left:21px;background:#fff2d5}.ds-switch:focus-visible{outline:2px solid var(--accent,#b6f36a);outline-offset:3px}.ds-switch:disabled{opacity:.45;cursor:not-allowed}@media(max-width:600px){.ds-switch{width:44px;height:44px;min-height:44px;background:transparent;padding:0}.ds-switch:before{content:\"\";position:absolute;left:0;top:10px;width:44px;height:24px;border-radius:20px;background:#555}.ds-switch:after{left:3px;top:13px}.ds-switch[aria-checked=true],.ds-switch:hover,.ds-switch[aria-checked=true]:hover{background:transparent}.ds-switch[aria-checked=true]:before{background:var(--accent,#b6f36a)}.ds-switch[aria-checked=true]:after{left:3px;transform:translateX(20px)}}"
    }
